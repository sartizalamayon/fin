# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development points at a plain Postgres on your machine.
# Production uses the Supabase connection string.
DATABASE_URL=postgres://localhost:5432/money_management

# ---------------------------------------------------------------------------
# Supabase (auth + hosted Postgres)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Which OAuth buttons to show on the login screen. "google,azure" by default;
# set empty to show none. Each needs client credentials in Supabase to work.
NEXT_PUBLIC_AUTH_PROVIDERS=google,azure
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Secret encryption
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts each user's Groq API key at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored key undecryptable — users would re-enter theirs.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------
# There is deliberately no server-side Groq key. Every user brings their own
# from https://groq.com — it is encrypted with APP_ENCRYPTION_KEY and never
# returned to the browser. This variable only overrides the default model.
GROQ_MODEL=llama-3.3-70b-versatile
